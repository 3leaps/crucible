{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:durable-queue/v0/capability-profile.schema.json",
  "title": "Queue Capability Profile",
  "description": "Discovery root for contract: durable-queue/v0. One backend's declaration, split into immutable build facts and effective runtime facts. origin harness means the conformance controls produced it; origin declared is an unverified claim. Fencing and keyed deduplication are core, not capabilities. Semantic rule enforced by controls: runtime.enabled_capabilities is a subset of build.compiled_capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilities",
    "backend",
    "origin",
    "conformance",
    "ledger",
    "idempotency_window_ms",
    "build",
    "runtime"
  ],
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "contract: durable-queue/v0"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "backend": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "origin": {
      "enum": [
        "harness",
        "declared"
      ]
    },
    "conformance": {
      "enum": [
        "deterministic",
        "benchmark_only"
      ],
      "description": "deterministic: virtual clock, recorded ledger, exact normalized ledger match on every core vector. benchmark_only: the backend was exercised for measurement and makes no conformance claim. A tolerant wall-clock mode is deferred and not advertised in v0."
    },
    "ledger": {
      "enum": [
        "recorded",
        "inferred"
      ],
      "description": "recorded: every transition appends its events in the same atomic step. inferred: reconstructed by an adapter; not an authoritative history and not admissible for deterministic conformance."
    },
    "idempotency_window_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "unbounded"
        }
      ],
      "description": "Required. Keyed deduplication is core; this is how long a key is live from the original enqueued event."
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "version",
        "target",
        "native_dependencies",
        "compiled_backends",
        "compiled_capabilities"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "native_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compiled_backends": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "compiled_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "transactional_enqueue",
              "atomic_fanout",
              "delay",
              "ordering_key",
              "priority",
              "payload_ref",
              "long_poll",
              "virtual_clock"
            ]
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_backend",
        "failure_model",
        "enabled_capabilities"
      ],
      "properties": {
        "selected_backend": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "failure_model": {
          "enum": [
            "survives_power_loss",
            "survives_process_loss",
            "none"
          ],
          "description": "The strongest failure an acknowledged enqueue or fan_out survives, as a guarantee. Independent of how the commit is implemented."
        },
        "commit_strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Informational only (for example fsync-each-commit, group-commit-5ms, aof-everysec). Never upgrades failure_model."
        },
        "enabled_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "transactional_enqueue",
              "atomic_fanout",
              "delay",
              "ordering_key",
              "priority",
              "payload_ref",
              "long_poll",
              "virtual_clock"
            ]
          }
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "conformance": {
            "const": "deterministic"
          }
        }
      },
      "then": {
        "properties": {
          "ledger": {
            "const": "recorded"
          },
          "origin": {
            "const": "harness"
          },
          "runtime": {
            "properties": {
              "enabled_capabilities": {
                "contains": {
                  "const": "virtual_clock"
                }
              }
            }
          }
        }
      }
    }
  ]
}
