{
  "name": "atomic-fanout",
  "requires": [
    "virtual_clock",
    "atomic_fanout"
  ],
  "clock_start": "2026-01-01T00:00:00Z",
  "description": "fan_out enqueues the children and acks the parent in one atomic step. Children carry parent_id. A crash between the two is impossible by construction; a repeated fan_out after a redelivery deduplicates the children by key.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "g1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$p",
            "deduplicated": false
          }
        ]
      }
    },
    {
      "at_ms": 0,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$lp": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 10,
      "op": "fan_out",
      "params": {
        "parent": "$lp",
        "children": [
          {
            "idempotency_key": "g1:r1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          },
          {
            "idempotency_key": "g1:r2",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 2
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$c1",
            "deduplicated": false
          },
          {
            "message_id": "$c2",
            "deduplicated": false
          }
        ]
      }
    },
    {
      "at_ms": 20,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w2",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 2
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$p",
      "at": "2026-01-01T00:00:00Z",
      "idempotency_key": "g1",
      "payload_digest": "sha256:2bfd14f43d17fc7cea24e0917a8879b4b2f880b8baeec1b9d90fbaad655e71bd"
    },
    {
      "v": 0,
      "seq": 2,
      "queue": "q",
      "type": "leased",
      "message_id": "$p",
      "at": "2026-01-01T00:00:00Z",
      "attempt": 1,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:01Z"
    },
    {
      "v": 0,
      "seq": 3,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$c1",
      "at": "2026-01-01T00:00:00.010Z",
      "idempotency_key": "g1:r1",
      "payload_digest": "sha256:2bfd14f43d17fc7cea24e0917a8879b4b2f880b8baeec1b9d90fbaad655e71bd",
      "parent_id": "$p"
    },
    {
      "v": 0,
      "seq": 4,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$c2",
      "at": "2026-01-01T00:00:00.010Z",
      "idempotency_key": "g1:r2",
      "payload_digest": "sha256:363379742f80b51bdb9206579af7754911543079b9399cb3fc315fb199f476e8",
      "parent_id": "$p"
    },
    {
      "v": 0,
      "seq": 5,
      "queue": "q",
      "type": "acked",
      "message_id": "$p",
      "at": "2026-01-01T00:00:00.010Z",
      "attempt": 1
    },
    {
      "v": 0,
      "seq": 6,
      "queue": "q",
      "type": "leased",
      "message_id": "$c1",
      "at": "2026-01-01T00:00:00.020Z",
      "attempt": 1,
      "worker": "w2",
      "lease_until": "2026-01-01T00:00:01.020Z"
    },
    {
      "v": 0,
      "seq": 7,
      "queue": "q",
      "type": "leased",
      "message_id": "$c2",
      "at": "2026-01-01T00:00:00.020Z",
      "attempt": 1,
      "worker": "w2",
      "lease_until": "2026-01-01T00:00:01.020Z"
    }
  ]
}
