{
  "name": "fanout-mixed-children",
  "requires": [
    "virtual_clock",
    "atomic_fanout"
  ],
  "min_idempotency_window_ms": 60000,
  "clock_start": "2026-01-01T00:00:00Z",
  "queue": "q",
  "description": "Under a live parent, fan_out children are admitted individually: one new child is accepted, one repeats a live key with identical content (deduplicated), one repeats a live key with different content (conflict). All three outcomes and the parent ack form one atomic group; a child conflict does not abort the group.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "g1:r1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          },
          {
            "idempotency_key": "g1:r2",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 2
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$c1",
            "outcome": "accepted"
          },
          {
            "message_id": "$c2",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 5,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "g1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$p",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 10,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 3
      },
      "bind": {
        "$lp": "deliveries[2].lease"
      }
    },
    {
      "at_ms": 20,
      "op": "fan_out",
      "params": {
        "parent": "$lp",
        "children": [
          {
            "idempotency_key": "g1:r1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          },
          {
            "idempotency_key": "g1:r2",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 99
            }
          },
          {
            "idempotency_key": "g1:r3",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 3
            }
          }
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipts": [
          {
            "message_id": "$c1",
            "outcome": "deduplicated"
          },
          {
            "message_id": "$c2",
            "outcome": "conflict"
          },
          {
            "message_id": "$c3",
            "outcome": "accepted"
          }
        ]
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "group": 1,
      "group_size": 2,
      "queue": "q",
      "type": "enqueued",
