{
  "name": "fanout-stale-parent",
  "requires": [
    "virtual_clock",
    "atomic_fanout"
  ],
  "clock_start": "2026-01-01T00:00:00Z",
  "queue": "q",
  "description": "fan_out with an expired parent lease returns stale_lease, accepts no children, and appends nothing; the parent is redelivered and the fan-out succeeds on attempt 2.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "g1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$p",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 0,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$lp": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 1500,
      "op": "sweep",
      "params": {
        "queue": "q"
      },
      "expect": {
        "expired": 1,
        "purged": 0
      }
    },
    {
      "at_ms": 1550,
      "op": "fan_out",
      "params": {
        "parent": "$lp",
        "children": [
          {
            "idempotency_key": "g1:r1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "outcome": "stale_lease",
        "receipts": []
      }
    },
    {
      "at_ms": 1600,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w2",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$lp2": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 1610,
      "op": "fan_out",
      "params": {
        "parent": "$lp2",
        "children": [
          {
            "idempotency_key": "g1:r1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipts": [
          {
            "message_id": "$c1",
            "outcome": "accepted"
          }
        ]
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "group": 1,
      "group_size": 1,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$p",
      "at": "2026-01-01T00:00:00Z",
      "idempotency_key": "g1",
      "payload_digest": "sha256:773847a353f229f0d4e722106187ba5c0d6472c190c9103aba8ff40bf1d5d364"
    },
    {
      "v": 0,
      "seq": 2,
      "group": 2,
      "group_size": 1,
      "queue": "q",
      "type": "leased",
      "message_id": "$p",
      "at": "2026-01-01T00:00:00Z",
      "attempt": 1,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:01Z"
    },
    {
      "v": 0,
      "seq": 3,
      "group": 3,
      "group_size": 1,
      "queue": "q",
      "type": "lease_expired",
      "message_id": "$p",
      "at": "2026-01-01T00:00:01.500Z",
      "attempt": 1
    },
    {
      "v": 0,
      "seq": 4,
      "group": 4,
      "group_size": 1,
      "queue": "q",
      "type": "leased",
      "message_id": "$p",
      "at": "2026-01-01T00:00:01.600Z",
      "attempt": 2,
      "worker": "w2",
      "lease_until": "2026-01-01T00:00:02.600Z"
    },
    {
      "v": 0,
      "seq": 5,
      "group": 5,
      "group_size": 2,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$c1",
      "at": "2026-01-01T00:00:01.610Z",
      "idempotency_key": "g1:r1",
      "payload_digest": "sha256:773847a353f229f0d4e722106187ba5c0d6472c190c9103aba8ff40bf1d5d364",
      "parent_id": "$p"
    },
    {
      "v": 0,
      "seq": 6,
      "group": 5,
      "group_size": 2,
      "queue": "q",
      "type": "acked",
      "message_id": "$p",
      "at": "2026-01-01T00:00:01.610Z",
      "attempt": 2
    }
  ]
}
