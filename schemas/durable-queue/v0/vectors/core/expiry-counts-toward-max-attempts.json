{
  "name": "expiry-counts-toward-max-attempts",
  "requires": [
    "virtual_clock"
  ],
  "clock_start": "2026-01-01T00:00:00Z",
  "queue": "q",
  "description": "A lease expiry consumes an attempt exactly as a nack does; at max_attempts the lease_expired and dead_lettered events form one atomic group.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "k1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            },
            "max_attempts": 2
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$m1",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 0,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      }
    },
    {
      "at_ms": 1500,
      "op": "sweep",
      "params": {
        "queue": "q"
      },
      "expect": {
        "expired": 1,
        "purged": 0
      }
    },
    {
      "at_ms": 1500,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      }
    },
    {
      "at_ms": 3000,
      "op": "sweep",
      "params": {
        "queue": "q"
      },
      "expect": {
        "expired": 1,
        "purged": 0
      }
    },
    {
      "at_ms": 3000,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 0
      }
    },
    {
      "at_ms": 3000,
      "op": "stats",
      "params": {
        "queue": "q"
      },
      "expect": {
        "ready": 0,
        "delayed": 0,
        "leased": 0,
        "dead": 1
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "group": 1,
      "group_size": 1,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00Z",
      "idempotency_key": "k1",
      "payload_digest": "sha256:773847a353f229f0d4e722106187ba5c0d6472c190c9103aba8ff40bf1d5d364"
    },
    {
      "v": 0,
      "seq": 2,
      "group": 2,
      "group_size": 1,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00Z",
      "attempt": 1,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:01Z"
    },
    {
      "v": 0,
      "seq": 3,
      "group": 3,
      "group_size": 1,
      "queue": "q",
      "type": "lease_expired",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:01.500Z",
      "attempt": 1
    },
    {
      "v": 0,
      "seq": 4,
      "group": 4,
      "group_size": 1,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:01.500Z",
      "attempt": 2,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:02.500Z"
    },
    {
      "v": 0,
      "seq": 5,
      "group": 5,
      "group_size": 2,
      "queue": "q",
      "type": "lease_expired",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:03Z",
      "attempt": 2
    },
    {
      "v": 0,
      "seq": 6,
      "group": 5,
      "group_size": 2,
      "queue": "q",
      "type": "dead_lettered",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:03Z",
      "reason": "max_attempts"
    }
  ]
}
