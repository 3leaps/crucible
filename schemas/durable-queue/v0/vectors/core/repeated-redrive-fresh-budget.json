{
  "name": "repeated-redrive-fresh-budget",
  "requires": [
    "virtual_clock"
  ],
  "min_idempotency_window_ms": 60000,
  "clock_start": "2026-01-01T00:00:00Z",
  "queue": "q",
  "description": "Each redrive grants a fresh budget equal to the original max_attempts (here 1), never a compounded one; the attempt counter keeps rising. After the third nack the message is dead-lettered again.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "k1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            },
            "max_attempts": 1
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$m1",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 0,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l1": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 10,
      "op": "nack",
      "params": {
        "leases": [
          "$l1"
        ],
        "retry_after_ms": 0,
        "reason": "r"
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    },
    {
      "at_ms": 20,
      "op": "redrive",
      "params": {
        "queue": "q",
        "message_ids": [
          "$m1"
        ]
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    },
    {
      "at_ms": 30,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l2": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 40,
      "op": "nack",
      "params": {
        "leases": [
          "$l2"
        ],
        "retry_after_ms": 0,
        "reason": "r"
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    },
    {
      "at_ms": 50,
      "op": "redrive",
      "params": {
        "queue": "q",
        "message_ids": [
          "$m1"
        ]
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    },
    {
      "at_ms": 60,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l3": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 70,
      "op": "nack",
      "params": {
        "leases": [
          "$l3"
        ],
        "retry_after_ms": 0,
        "reason": "r"
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    },
    {
      "at_ms": 80,
      "op": "stats",
      "params": {
        "queue": "q"
      },
      "expect": {
        "ready": 0,
        "delayed": 0,
        "leased": 0,
        "dead": 1
      }
    }
  ],
  "ledger": [
