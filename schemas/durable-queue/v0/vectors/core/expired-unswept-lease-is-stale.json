{
  "name": "expired-unswept-lease-is-stale",
  "requires": [
    "virtual_clock"
  ],
  "min_idempotency_window_ms": 60000,
  "clock_start": "2026-01-01T00:00:00Z",
  "queue": "q",
  "description": "A lease operation at or after lease expiry returns stale_lease and appends nothing, even when no sweep has run; equality with the expiry instant counts as expired. The next claim appends lease_expired and the new lease in one group.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "k1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$m1",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 0,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l1": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 1000,
      "op": "ack",
      "params": {
        "leases": [
          "$l1"
        ]
      },
      "expect": {
        "outcomes": [
          "stale_lease"
        ]
      }
    },
    {
      "at_ms": 1500,
      "op": "extend",
      "params": {
        "leases": [
          "$l1"
        ],
        "lease_ms": 1000
      },
      "expect": {
        "outcomes": [
          "stale_lease"
        ]
      }
    },
    {
      "at_ms": 1600,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w2",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l2": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 1700,
      "op": "ack",
      "params": {
        "leases": [
          "$l2"
        ]
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "group": 1,
      "group_size": 1,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00Z",
      "idempotency_key": "k1",
      "payload_digest": "sha256:773847a353f229f0d4e722106187ba5c0d6472c190c9103aba8ff40bf1d5d364"
    },
    {
      "v": 0,
      "seq": 2,
      "group": 2,
      "group_size": 1,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00Z",
      "attempt": 1,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:01Z"
    },
    {
      "v": 0,
      "seq": 3,
      "group": 3,
      "group_size": 2,
      "queue": "q",
      "type": "lease_expired",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:01.600Z",
      "attempt": 1
    },
    {
      "v": 0,
      "seq": 4,
      "group": 3,
      "group_size": 2,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:01.600Z",
      "attempt": 2,
      "worker": "w2",
      "lease_until": "2026-01-01T00:00:02.600Z"
    },
    {
      "v": 0,
      "seq": 5,
      "group": 5,
      "group_size": 1,
      "queue": "q",
      "type": "acked",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:01.700Z",
      "attempt": 2
    }
  ]
}
