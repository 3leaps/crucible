{
  "name": "fractional-clock-start-carry",
  "requires": [
    "virtual_clock",
    "delay"
  ],
  "min_idempotency_window_ms": 60000,
  "clock_start": "2026-01-01T00:00:00.999Z",
  "queue": "q",
  "description": "A fractional clock_start: every derived instant is clock_start plus at_ms, carrying into the next second (enqueue at, lease until, nack not_before) and keeping a fraction where the sum has one.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "k1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            },
            "max_attempts": 2
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$m1",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 1,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 2000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l1": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 1001,
      "op": "nack",
      "params": {
        "leases": [
          "$l1"
        ],
        "retry_after_ms": 1000,
        "reason": "transient"
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    },
    {
      "at_ms": 2000,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 0
      }
    },
    {
      "at_ms": 2001,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l2": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 2101,
      "op": "ack",
      "params": {
        "leases": [
          "$l2"
        ]
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "group": 1,
      "group_size": 1,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00.999Z",
      "idempotency_key": "k1",
      "payload_digest": "sha256:773847a353f229f0d4e722106187ba5c0d6472c190c9103aba8ff40bf1d5d364"
    },
    {
      "v": 0,
      "seq": 2,
      "group": 2,
      "group_size": 1,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:01Z",
      "attempt": 1,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:03Z"
    },
    {
      "v": 0,
      "seq": 3,
      "group": 3,
      "group_size": 1,
      "queue": "q",
      "type": "nacked",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:02Z",
      "attempt": 1,
      "reason": "transient",
      "not_before": "2026-01-01T00:00:03Z"
    },
    {
      "v": 0,
      "seq": 4,
      "group": 4,
      "group_size": 1,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:03Z",
      "attempt": 2,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:04Z"
    },
    {
      "v": 0,
      "seq": 5,
      "group": 5,
      "group_size": 1,
      "queue": "q",
      "type": "acked",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:03.100Z",
      "attempt": 2
    }
  ]
}
