{
  "name": "stale-lease-ack",
  "requires": [
    "virtual_clock",
    "fenced_ack"
  ],
  "clock_start": "2026-01-01T00:00:00Z",
  "description": "After expiry and redelivery, an ack with the old lease returns stale_lease and appends nothing. The ledger is identical to lease-expiry-redelivery.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "k1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$m1",
            "deduplicated": false
          }
        ]
      }
    },
    {
      "at_ms": 0,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l1": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 1500,
      "op": "sweep",
      "params": {
        "queue": "q"
      },
      "expect": {
        "expired": 1
      }
    },
    {
      "at_ms": 1500,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w2",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l2": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 1550,
      "op": "ack",
      "params": {
        "leases": [
          "$l1"
        ]
      },
      "expect": {
        "outcomes": [
          "stale_lease"
        ]
      }
    },
    {
      "at_ms": 1600,
      "op": "ack",
      "params": {
        "leases": [
          "$l2"
        ]
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    },
    {
      "at_ms": 1700,
      "op": "ack",
      "params": {
        "leases": [
          "$l2"
        ]
      },
      "expect": {
        "outcomes": [
          "stale_lease"
        ]
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00Z",
      "idempotency_key": "k1",
      "payload_digest": "sha256:2bfd14f43d17fc7cea24e0917a8879b4b2f880b8baeec1b9d90fbaad655e71bd"
    },
    {
      "v": 0,
      "seq": 2,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00Z",
      "attempt": 1,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:01Z"
    },
    {
      "v": 0,
      "seq": 3,
      "queue": "q",
      "type": "lease_expired",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:01.500Z",
      "attempt": 1
    },
    {
      "v": 0,
      "seq": 4,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:01.500Z",
      "attempt": 2,
      "worker": "w2",
      "lease_until": "2026-01-01T00:00:02.500Z"
    },
    {
      "v": 0,
      "seq": 5,
      "queue": "q",
      "type": "acked",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:01.600Z",
      "attempt": 2
    }
  ]
}
