{
  "name": "enqueue-claim-ack",
  "requires": [
    "virtual_clock"
  ],
  "clock_start": "2026-01-01T00:00:00Z",
  "description": "One message travels enqueued, leased, acked. Deterministic mode claims ready messages in seq order.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "k1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$m1",
            "deduplicated": false
          }
        ]
      }
    },
    {
      "at_ms": 10,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 30000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$l1": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 20,
      "op": "ack",
      "params": {
        "leases": [
          "$l1"
        ]
      },
      "expect": {
        "outcomes": [
          "ok"
        ]
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00Z",
      "idempotency_key": "k1",
      "payload_digest": "sha256:2bfd14f43d17fc7cea24e0917a8879b4b2f880b8baeec1b9d90fbaad655e71bd"
    },
    {
      "v": 0,
      "seq": 2,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00.010Z",
      "attempt": 1,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:30.010Z"
    },
    {
      "v": 0,
      "seq": 3,
      "queue": "q",
      "type": "acked",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00.020Z",
      "attempt": 1
    }
  ]
}
