{
  "name": "changed-content-conflict",
  "requires": [
    "virtual_clock"
  ],
  "min_idempotency_window_ms": 60000,
  "clock_start": "2026-01-01T00:00:00Z",
  "queue": "q",
  "description": "A repeated key with a different identity digest within the window is a conflict: nothing is accepted, the receipt names the original, and a conflicted audit event records the rejected digest.",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "k1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$m1",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 5,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "k1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 99
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$m1",
            "outcome": "conflict"
          }
        ]
      }
    },
    {
      "at_ms": 10,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1,
        "deliveries": [
          {
            "message": {
              "payload": {
                "n": 1
              }
            }
          }
        ]
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "group": 1,
      "group_size": 1,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00Z",
      "idempotency_key": "k1",
      "payload_digest": "sha256:773847a353f229f0d4e722106187ba5c0d6472c190c9103aba8ff40bf1d5d364"
    },
    {
      "v": 0,
      "seq": 2,
      "group": 2,
      "group_size": 1,
      "queue": "q",
      "type": "conflicted",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00.005Z",
      "idempotency_key": "k1",
      "payload_digest": "sha256:21b1fc55aa9f6c1cdc6e63d40f8d97692546db33818cb98633d7a155683dc78e"
    },
    {
      "v": 0,
      "seq": 3,
      "group": 3,
      "group_size": 1,
      "queue": "q",
      "type": "leased",
      "message_id": "$m1",
      "at": "2026-01-01T00:00:00.010Z",
      "attempt": 1,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:01.010Z"
    }
  ]
}
