{
  "name": "fanout-after-parent-expiry",
  "requires": [
    "virtual_clock",
    "atomic_fanout"
  ],
  "min_idempotency_window_ms": 60000,
  "clock_start": "2026-01-01T00:00:00Z",
  "queue": "q",
  "description": "Happy-path ordering evidence only: fan_out appends the children's enqueued events and the parent's acked event as one atomic group, children carry parent_id and go to the parent's queue. Crash atomicity and repeated-call behaviour need their own evidence (see fanout-stale-parent and fanout-repeat-dedup).",
  "ops": [
    {
      "at_ms": 0,
      "op": "enqueue",
      "params": {
        "queue": "q",
        "messages": [
          {
            "idempotency_key": "g1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          }
        ]
      },
      "expect": {
        "receipts": [
          {
            "message_id": "$p",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 0,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w1",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 1
      },
      "bind": {
        "$lp": "deliveries[0].lease"
      }
    },
    {
      "at_ms": 1011,
      "op": "fan_out",
      "params": {
        "parent": "$lp",
        "children": [
          {
            "idempotency_key": "g1:r1",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 1
            }
          },
          {
            "idempotency_key": "g1:r2",
            "payload_contract": "contract: example/v0",
            "payload": {
              "n": 2
            }
          }
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipts": [
          {
            "message_id": "$c1",
            "outcome": "accepted"
          },
          {
            "message_id": "$c2",
            "outcome": "accepted"
          }
        ]
      }
    },
    {
      "at_ms": 20,
      "op": "claim",
      "params": {
        "queue": "q",
        "worker": "w2",
        "max": 10,
        "lease_ms": 1000,
        "wait_ms": 0
      },
      "expect": {
        "delivery_count": 2
      }
    }
  ],
  "ledger": [
    {
      "v": 0,
      "seq": 1,
      "group": 1,
      "group_size": 1,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$p",
      "at": "2026-01-01T00:00:00Z",
      "idempotency_key": "g1",
      "payload_digest": "sha256:773847a353f229f0d4e722106187ba5c0d6472c190c9103aba8ff40bf1d5d364"
    },
    {
      "v": 0,
      "seq": 2,
      "group": 2,
      "group_size": 1,
      "queue": "q",
      "type": "leased",
      "message_id": "$p",
      "at": "2026-01-01T00:00:00Z",
      "attempt": 1,
      "worker": "w1",
      "lease_until": "2026-01-01T00:00:01Z"
    },
    {
      "v": 0,
      "seq": 3,
      "group": 3,
      "group_size": 3,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$c1",
      "at": "2026-01-01T00:00:01.011Z",
      "idempotency_key": "g1:r1",
      "payload_digest": "sha256:773847a353f229f0d4e722106187ba5c0d6472c190c9103aba8ff40bf1d5d364",
      "parent_id": "$p"
    },
    {
      "v": 0,
      "seq": 4,
      "group": 3,
      "group_size": 3,
      "queue": "q",
      "type": "enqueued",
      "message_id": "$c2",
      "at": "2026-01-01T00:00:01.011Z",
      "idempotency_key": "g1:r2",
      "payload_digest": "sha256:8d43d6dd9ea4004ecfd302ce920e093e3285ffa847dfa4ba99ce9e8c3787abe4",
      "parent_id": "$p"
    },
    {
      "v": 0,
      "seq": 5,
      "group": 3,
      "group_size": 3,
      "queue": "q",
      "type": "acked",
      "message_id": "$p",
      "at": "2026-01-01T00:00:01.011Z",
      "attempt": 1
    },
    {
      "v": 0,
      "seq": 6,
      "group": 6,
      "group_size": 2,
      "queue": "q",
      "type": "leased",
      "message_id": "$c1",
      "at": "2026-01-01T00:00:00.020Z",
      "attempt": 1,
      "worker": "w2",
      "lease_until": "2026-01-01T00:00:01.020Z"
    },
    {
      "v": 0,
      "seq": 7,
      "group": 6,
      "group_size": 2,
      "queue": "q",
      "type": "leased",
      "message_id": "$c2",
      "at": "2026-01-01T00:00:00.020Z",
      "attempt": 1,
      "worker": "w2",
      "lease_until": "2026-01-01T00:00:01.020Z"
    }
  ],
  "expect_reject": "expectation_mismatch"
}
