{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:filesystem-access/v0/cases.schema.json",
  "title": "Filesystem Access Declarative Recipe Cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["capabilities", "cases"],
  "properties": {
    "capabilities": {
      "const": ["contract: filesystem-access/v0"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,95}$"
    },
    "recipe_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$",
      "allOf": [
        {
          "not": {
            "pattern": "(^|/)[.][.]?(/|$)"
          }
        },
        {
          "not": {
            "pattern": "//"
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {
          "$ref": "#/$defs/recipe_name"
        },
        "kind": {
          "enum": ["directory", "regular_file", "symlink", "fifo", "mount_boundary"]
        },
        "target": {
          "type": "string",
          "maxLength": 4096
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outside_root": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "symlink"
              }
            }
          },
          "then": {
            "required": ["target"]
          },
          "else": {
            "not": {
              "required": ["target"]
            }
          }
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "enum": ["accepted", "refused"]
        },
        "category": {
          "enum": [
            "invalid_name",
            "policy_denied",
            "unsupported_capability",
            "not_found",
            "already_exists",
            "wrong_type",
            "bound_exceeded",
            "io_error",
            "unknown_mutation_outcome"
          ]
        },
        "reason": {
          "enum": [
            "escape",
            "link_refused",
            "reparse_refused",
            "special_file",
            "cross_device",
            "hop_limit"
          ]
        },
        "resolved_path": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutation": {
          "const": "created"
        },
        "same_object": {
          "type": "boolean"
        },
        "identity": {
          "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/object_identity"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["directory", "regular_file", "symlink", "reparse_point", "other"]
              }
            }
          }
        },
        "preserves_nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["category"]
                },
                {
                  "required": ["reason"]
                }
              ]
            }
          },
          "else": {
            "required": ["category"]
          }
        },
        {
          "if": {
            "required": ["category"],
            "properties": {
              "category": {
                "const": "policy_denied"
              }
            }
          },
          "then": {
            "required": ["reason"]
          },
          "else": {
            "not": {
              "required": ["reason"]
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "profile", "name", "recipe", "expected"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/operation"
        },
        "profile": {
          "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/profile"
        },
        "name": {
          "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/raw_name"
        },
        "recipe": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "request": {
          "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/capabilities"
        },
        "access_request": {
          "$ref": "contract:filesystem-access/v0/access-request.schema.json"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "no_xdev_available": {
              "type": "boolean"
            },
            "adversary_level": {
              "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/adversary"
            },
            "kernel_atomic": {
              "type": "boolean"
            },
            "fault_after_create": {
              "type": "boolean"
            },
            "live_handles": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["handle", "generation", "object"],
                "properties": {
                  "handle": {
                    "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/handle_ref"
                  },
                  "generation": {
                    "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/lifetime_generation"
                  },
                  "object": {
                    "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/object_identity"
                  }
                }
              }
            },
            "root_bindings": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ref", "path"],
                "properties": {
                  "ref": {
                    "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/root_ref"
                  },
                  "path": {
                    "oneOf": [
                      {
                        "const": ""
                      },
                      {
                        "$ref": "#/$defs/recipe_name"
                      }
                    ]
                  },
                  "identity": {
                    "$ref": "contract:filesystem-access/v0/common.schema.json#/$defs/object_identity"
                  }
                }
              }
            }
          }
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "max_symlink_hops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "note": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": ["open_read", "create_exclusive", "read_dir"]
              }
            }
          },
          "then": {
            "not": {
              "required": ["access_request"]
            }
          },
          "else": {
            "required": ["access_request"],
            "not": {
              "anyOf": [
                {
                  "required": ["request"]
                },
                {
                  "required": ["max_bytes"]
                },
                {
                  "required": ["max_entries"]
                },
                {
                  "required": ["max_symlink_hops"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "open_root"
              }
            }
          },
          "then": {
            "properties": {
              "access_request": {
                "properties": {
                  "operation": {
                    "const": "open_root"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "stat"
              }
            }
          },
          "then": {
            "properties": {
              "access_request": {
                "properties": {
                  "operation": {
                    "const": "stat"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "same_object"
              }
            }
          },
          "then": {
            "properties": {
              "access_request": {
                "properties": {
                  "operation": {
                    "const": "same_object"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "open_root"
              }
            }
          },
          "then": {
            "required": ["runtime"],
            "properties": {
              "runtime": {
                "required": ["root_bindings"]
              }
            }
          }
        }
      ]
    }
  }
}
