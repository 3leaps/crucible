{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:durable-record/v1/journal-entry.schema.json",
  "title": "Durable Record Journal Entry",
  "description": "Append-only durable-record/v1 journal. Nested records use record envelope v: 1. Protection requests change use eligibility, never record bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "seq",
    "group",
    "group_size",
    "stream",
    "type",
    "at"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "group": {
      "type": "integer",
      "minimum": 1,
      "description": "seq of the first entry in this entry's atomic group; equals seq for a single-entry step."
    },
    "group_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of entries in this entry's atomic group. A prefix ending at seq N is a consistent cut iff, for the entry at N, N - group + 1 == group_size."
    },
    "stream": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "type": {
      "enum": [
        "stream_opened",
        "appended",
        "revised",
        "deduplicated",
        "conflicted",
        "retired",
        "tombstoned",
        "untombstoned",
        "restrictions_reviewed"
      ],
      "description": "Closed vocabulary. Unknown types are rejected."
    },
    "at": {
      "$ref": "#/$defs/instant",
      "description": "Store clock, RFC 3339 UTC."
    },
    "mode": {
      "enum": [
        "single_revision",
        "revisioned"
      ]
    },
    "failure_model": {
      "enum": [
        "survives_power_loss",
        "survives_process_loss",
        "none"
      ]
    },
    "record": {
      "$ref": "#/$defs/record"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "presented": {
      "$ref": "#/$defs/revisionPin"
    },
    "current": {
      "$ref": "#/$defs/revisionPin"
    },
    "body_status": {
      "enum": [
        "verified",
        "unverified"
      ]
    },
    "request": {
      "$ref": "#/$defs/protectionRequest"
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "continues": {
      "$ref": "#/$defs/sourceCut",
      "description": "Only on stream_opened: the source journal and cut this stream continues."
    },
    "imported_from": {
      "$ref": "#/$defs/sourcePin",
      "description": "Only on appended or revised in a continuation: the exact source pin this record re-records."
    },
    "source": {
      "$ref": "#/$defs/sourceCut"
    },
    "destination_cut_seq": {
      "type": "integer",
      "minimum": 1
    },
    "source_state_digest": {
      "$ref": "#/$defs/digest"
    },
    "destination_applied_state_digest": {
      "$ref": "#/$defs/digest"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "stream_opened"
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "failure_model"
        ],
        "properties": {
          "type": {
            "const": "stream_opened"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "appended",
              "revised"
            ]
          }
        }
      },
      "then": {
        "required": [
          "record",
          "digest",
          "idempotency_key"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "record_id"
              ]
            },
            {
              "required": [
                "revision"
              ]
            }
          ]
        },
        "if": {
          "properties": {
            "record": {
              "required": [
                "body"
              ]
            }
          }
        },
        "then": {
          "required": [
            "body_status"
          ]
        },
        "else": {
          "not": {
            "required": [
              "body_status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "appended"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "properties": {
              "revision": {
                "const": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "revised"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "properties": {
              "revision": {
                "minimum": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "stream_opened"
          }
        }
      },
      "then": {
        "properties": {
          "seq": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "deduplicated"
          }
        }
      },
      "then": {
        "required": [
          "record_id",
          "idempotency_key"
        ],
        "properties": {
          "type": {
            "const": "deduplicated"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "conflicted"
          }
        }
      },
      "then": {
        "required": [
          "record_id",
          "reason",
          "presented"
        ],
        "properties": {
          "type": {
            "const": "conflicted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "retired"
          }
        }
      },
      "then": {
        "required": [
          "record_id",
          "reason"
        ],
        "properties": {
          "type": {
            "const": "retired"
          }
        },
        "if": {
          "required": [
            "idempotency_key"
          ]
        },
        "then": {
          "required": [
            "request_digest"
          ]
        },
        "else": {
          "not": {
            "required": [
              "request_digest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "tombstoned",
              "untombstoned"
            ]
          }
        }
      },
      "then": {
        "required": [
          "request",
          "request_digest"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "record"
              ]
            },
            {
              "required": [
                "record_id"
              ]
            },
            {
              "required": [
                "revision"
              ]
            },
            {
              "required": [
                "digest"
              ]
            },
            {
              "required": [
                "idempotency_key"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "presented"
              ]
            },
            {
              "required": [
                "current"
              ]
            },
            {
              "required": [
                "body_status"
              ]
            },
            {
              "required": [
                "mode"
              ]
            },
            {
              "required": [
                "failure_model"
              ]
            }
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "request"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tombstoned"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "properties": {
              "action": {
                "const": "tombstone"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "untombstoned"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "properties": {
              "action": {
                "const": "restore"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "not": {
              "enum": [
                "tombstoned",
                "untombstoned",
                "retired"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "request_digest"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "restrictions_reviewed"
          }
        }
      },
      "then": {
        "required": [
          "source",
          "destination_cut_seq",
          "source_state_digest",
          "destination_applied_state_digest",
          "authorization",
          "provenance"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "record"
              ]
            },
            {
              "required": [
                "record_id"
              ]
            },
            {
              "required": [
                "revision"
              ]
            },
            {
              "required": [
                "digest"
              ]
            },
            {
              "required": [
                "idempotency_key"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "presented"
              ]
            },
            {
              "required": [
                "current"
              ]
            },
            {
              "required": [
                "body_status"
              ]
            },
            {
              "required": [
                "mode"
              ]
            },
            {
              "required": [
                "failure_model"
              ]
            },
            {
              "required": [
                "request"
              ]
            },
            {
              "required": [
                "request_digest"
              ]
            },
            {
              "required": [
                "continues"
              ]
            },
            {
              "required": [
                "imported_from"
              ]
            }
          ]
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "source"
              ]
            },
            {
              "required": [
                "destination_cut_seq"
              ]
            },
            {
              "required": [
                "source_state_digest"
              ]
            },
            {
              "required": [
                "destination_applied_state_digest"
              ]
            },
            {
              "required": [
                "authorization"
              ]
            },
            {
              "required": [
                "provenance"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "stream_opened"
          }
        }
      },
      "then": {},
      "else": {
        "not": {
          "required": [
            "continues"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "appended",
              "revised"
            ]
          }
        }
      },
      "then": {},
      "else": {
        "not": {
          "required": [
            "imported_from"
          ]
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revisionPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "digest"
      ],
      "description": "Revision within the enclosing stream and record.",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream",
        "record_id",
        "revision",
        "digest"
      ],
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "bodyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "length",
        "media_type"
      ],
      "description": "Bytes held outside the record, bound by digest and length. Retrieval hints never appear here.",
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,255}$",
          "description": "Optional contract: data-artifact/v0 artifact token."
        },
        "encryption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "key_ref"
          ],
          "properties": {
            "scheme": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
            },
            "key_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,255}$",
              "description": "Opaque token naming the key-custody record. Never key material."
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_kind",
        "actor"
      ],
      "description": "Who produced this revision. Model and tool describe the producer; they do not own the record.",
      "properties": {
        "actor_kind": {
          "enum": [
            "human",
            "agent",
            "process"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "supervisor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention",
        "sensitivity"
      ],
      "description": "Retention-lifecycle and sensitivity classifier keys. unknown is a deferred decision, not a default.",
      "properties": {
        "retention": {
          "enum": [
            "unknown",
            "transient",
            "short",
            "standard",
            "long",
            "legal-hold"
          ]
        },
        "sensitivity": {
          "enum": [
            "unknown",
            "0-public",
            "1-confidential",
            "2-blinded",
            "3-proprietary",
            "4-personal",
            "5-privileged",
            "6-eyes-only"
          ]
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "rel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "stream",
        "record_id",
        "revision",
        "payload_contract",
        "provenance",
        "classification"
      ],
      "oneOf": [
        {
          "required": [
            "payload"
          ],
          "not": {
            "required": [
              "body"
            ]
          }
        },
        {
          "required": [
            "body"
          ],
          "not": {
            "required": [
              "payload"
            ]
          }
        }
      ],
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "supersedes"
          ]
        }
      },
      "else": {
        "required": [
          "supersedes"
        ]
      },
      "properties": {
        "v": {
          "const": 1
        },
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes": {
          "$ref": "#/$defs/revisionPin",
          "description": "Required when revision > 1; forbidden at revision 1. Its revision must be exactly one less (semantic rule)."
        },
        "payload_contract": {
          "type": "string",
          "pattern": "^contract: [a-z0-9][a-z0-9-]*/v[0-9]+$",
          "description": "Host-less token naming the payload's own contract. Carried, never validated by the store."
        },
        "payload": {
          "description": "Inline I-JSON payload. Opaque to the store."
        },
        "body": {
          "$ref": "#/$defs/bodyRef"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "produced_at": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instant",
            "source"
          ],
          "description": "Producer's claim of when this revision was produced. Inside the record digest. Attribution, not an authoritative time; trusted_time evidence is opaque to the store and unverified until an adopter verifies it.",
          "properties": {
            "instant": {
              "$ref": "#/$defs/instant"
            },
            "source": {
              "enum": [
                "producer_clock",
                "trusted_time"
              ]
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ref",
                "digest"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
                },
                "digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          },
          "if": {
            "properties": {
              "source": {
                "const": "trusted_time"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "labels": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
          }
        },
        "links": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "protectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "enum": [
            "tombstone",
            "restore"
          ]
        },
        "target": {
          "$ref": "#/$defs/pin"
        },
        "scope": {
          "enum": [
            "record",
            "revision",
            "body"
          ]
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "digest",
            "length"
          ]
        },
        "restores": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "enum": [
            "source_removed",
            "source_corrected",
            "rights_restricted",
            "security_hold",
            "operator_hold",
            "source_restored",
            "hold_released"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "ref",
            "digest"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/instant"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "v",
        "stream",
        "idempotency_key",
        "action",
        "target",
        "scope",
        "reason",
        "evidence",
        "observed_at",
        "provenance"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "body"
              }
            }
          },
          "then": {
            "required": [
              "body"
            ]
          },
          "else": {
            "not": {
              "required": [
                "body"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "restore"
              }
            }
          },
          "then": {
            "required": [
              "restores"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "source_restored",
                  "hold_released"
                ]
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "restores"
              ]
            },
            "properties": {
              "reason": {
                "enum": [
                  "source_removed",
                  "source_corrected",
                  "rights_restricted",
                  "security_hold",
                  "operator_hold"
                ]
              }
            }
          }
        }
      ]
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "Canonical v1 instant: UTC, Z, exactly six fractional digits. Any other spelling is refused, never normalized."
    },
    "capability": {
      "enum": [
        "contract: durable-record/v0",
        "contract: durable-record/v1"
      ]
    },
    "sourceCut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "stream",
        "cut_seq",
        "cut_digest"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "cut_seq": {
          "type": "integer",
          "minimum": 1
        },
        "cut_digest": {
          "$ref": "#/$defs/digest",
          "description": "sha256 of the RFC 8785 JCS bytes of the source journal entries 1..cut_seq as one array."
        }
      }
    },
    "sourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "pin"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
