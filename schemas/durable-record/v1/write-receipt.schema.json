{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:durable-record/v1/write-receipt.schema.json",
  "title": "Durable Record Write Receipt and Reconciliation Result",
  "description": "Experimental durable-record/v1 companion. Structural schema companion for contract: durable-record/v1. Either a write receipt or the result of reconciling an indeterminate write by stream, idempotency key and attempt time. unknown is never evidence that a write was not accepted.",
  "oneOf": [
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/reconciliation"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream",
        "record_id",
        "revision",
        "digest"
      ],
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "outcome",
        "stream",
        "idempotency_key"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "receipt"
        },
        "outcome": {
          "enum": [
            "appended",
            "revised",
            "idempotency_conflict",
            "revision_conflict",
            "no_head",
            "mode_violation",
            "body_unverified",
            "retired_record",
            "target_not_found",
            "retired"
          ]
        },
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "failure_model": {
          "enum": [
            "survives_power_loss",
            "survives_process_loss",
            "none"
          ]
        },
        "body_status": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "current": {
          "$ref": "#/$defs/pin"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "appended",
                  "revised"
                ]
              }
            }
          },
          "then": {
            "required": [
              "pin",
              "seq",
              "failure_model"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "record_id"
                  ]
                },
                {
                  "required": [
                    "request_digest"
                  ]
                }
              ]
            }
          },
          "else": {
            "if": {
              "properties": {
                "outcome": {
                  "const": "retired"
                }
              }
            },
            "then": {
              "required": [
                "seq",
                "failure_model",
                "record_id",
                "request_digest"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "pin"
                    ]
                  },
                  {
                    "required": [
                      "body_status"
                    ]
                  }
                ]
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "pin"
                    ]
                  },
                  {
                    "required": [
                      "seq"
                    ]
                  },
                  {
                    "required": [
                      "failure_model"
                    ]
                  },
                  {
                    "required": [
                      "body_status"
                    ]
                  },
                  {
                    "required": [
                      "record_id"
                    ]
                  },
                  {
                    "required": [
                      "request_digest"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "revision_conflict"
              }
            }
          },
          "then": {
            "required": [
              "current"
            ]
          },
          "else": {
            "not": {
              "required": [
                "current"
              ]
            }
          }
        }
      ]
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "stream",
        "idempotency_key",
        "attempted_at",
        "result"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "reconciliation"
        },
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attempted_at": {
          "$ref": "#/$defs/instant"
        },
        "result": {
          "enum": [
            "found",
            "not_found",
            "unknown"
          ]
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "$ref": "#/$defs/protectionReceipt"
            }
          ]
        },
        "window_covers_from": {
          "$ref": "#/$defs/instant",
          "description": "Required for not_found: start of the store-clock interval in which every accepted key is retained; at or before the earliest instant the write could have been accepted."
        },
        "window_covers_until": {
          "$ref": "#/$defs/instant",
          "description": "Required for not_found: end of that interval; at or after attempted_at."
        },
        "reason": {
          "enum": [
            "window_elapsed",
            "key_evicted",
            "attempt_before_coverage",
            "coverage_unprovable",
            "no_keyed_deduplication"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "found"
              }
            }
          },
          "then": {
            "required": [
              "receipt"
            ],
            "properties": {
              "receipt": {
                "properties": {
                  "outcome": {
                    "enum": [
                      "appended",
                      "revised",
                      "tombstoned",
                      "untombstoned",
                      "retired"
                    ]
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reason"
                  ]
                },
                {
                  "required": [
                    "window_covers_from"
                  ]
                },
                {
                  "required": [
                    "window_covers_until"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "not_found"
              }
            }
          },
          "then": {
            "required": [
              "window_covers_from",
              "window_covers_until"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "receipt"
                  ]
                },
                {
                  "required": [
                    "reason"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "receipt"
                  ]
                },
                {
                  "required": [
                    "window_covers_from"
                  ]
                },
                {
                  "required": [
                    "window_covers_until"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "protectionReceipt": {
      "title": "Durable Record Protection Receipt",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "stream": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "enum": [
            "tombstoned",
            "untombstoned",
            "idempotency_conflict",
            "target_not_found",
            "body_mismatch",
            "hold_not_active",
            "hold_mismatch",
            "observation_order"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "failure_model": {
          "enum": [
            "survives_power_loss",
            "survives_process_loss",
            "none"
          ]
        }
      },
      "required": [
        "v",
        "stream",
        "idempotency_key",
        "outcome"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "tombstoned",
                  "untombstoned"
                ]
              }
            }
          },
          "then": {
            "required": [
              "seq",
              "request_digest",
              "failure_model"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "seq"
                  ]
                },
                {
                  "required": [
                    "request_digest"
                  ]
                },
                {
                  "required": [
                    "failure_model"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "Canonical v1 instant: UTC, Z, exactly six fractional digits. Any other spelling is refused, never normalized."
    }
  }
}
