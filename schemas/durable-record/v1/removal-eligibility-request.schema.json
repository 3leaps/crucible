{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:durable-record/v1/removal-eligibility-request.schema.json",
  "title": "Durable Record Removal Eligibility Request",
  "description": "Experimental durable-record/v1 logical decision input for evaluating external body byte removal eligibility at a consistent store-wide cut. Trusted store/verifier context, not a public API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "store",
    "store_streams",
    "observed_streams",
    "body",
    "incarnation",
    "mode",
    "reason",
    "decision_time",
    "expected_policy"
  ],
  "properties": {
    "store": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "store_streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/streamName"
      }
    },
    "observed_streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observedSharingStream"
      }
    },
    "body": {
      "$ref": "#/$defs/lifecycleBody"
    },
    "incarnation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "mode": {
      "enum": [
        "start",
        "retry_unlink"
      ]
    },
    "reason": {
      "enum": [
        "retention",
        "operator",
        "rights_restricted"
      ]
    },
    "decision_time": {
      "$ref": "#/$defs/instant"
    },
    "expected_policy": {
      "$ref": "#/$defs/policyBinding"
    },
    "quarantined_designated_streams": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/streamName"
      }
    },
    "authorization": {
      "$ref": "#/$defs/removalAuthorization"
    }
  },
  "$defs": {
    "streamName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]\\.[0-9]{6}Z$",
      "description": "Canonical v1 instant: UTC, Z, exactly six fractional digits. Any other spelling is refused, never normalized."
    },
    "lifecycleBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "length"
      ],
      "description": "Body lifecycle identity: digest and byte length only. No media type, encryption or retrieval hint.",
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "removalAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest",
        "store",
        "body",
        "incarnation",
        "policy",
        "action",
        "scope_verified",
        "not_before",
        "expires_at"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "store": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "body": {
          "$ref": "#/$defs/lifecycleBody"
        },
        "incarnation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy": {
          "$ref": "#/$defs/policyBinding"
        },
        "action": {
          "const": "remove_body"
        },
        "scope_verified": {
          "type": "boolean"
        },
        "not_before": {
          "$ref": "#/$defs/instant"
        },
        "expires_at": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "observedSharingStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream"
      ],
      "properties": {
        "stream": {
          "$ref": "#/$defs/streamName"
        },
        "damaged": {
          "type": "boolean"
        },
        "journal": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "raw_journal": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "source_journal": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "raw_source_journal": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ancestors": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "raw_ancestors": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "inherited_block": {
          "type": "boolean"
        },
        "source_seal": {
          "type": "object"
        }
      }
    }
  }
}
