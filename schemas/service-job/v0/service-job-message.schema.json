{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:service-job/v0/service-job-message.schema.json",
  "title": "Service Job Message",
  "description": "Discriminated entry schema for contract: service-job/v0. Thirteen message kinds only. The prose standard remains normative for catalog/offer integrity, placement fallback, idempotency, and legal transitions.",
  "oneOf": [
    { "$ref": "#/$defs/catalogListRequest" },
    { "$ref": "#/$defs/catalogListResponse" },
    { "$ref": "#/$defs/serviceDescribeRequest" },
    { "$ref": "#/$defs/serviceOffer" },
    { "$ref": "#/$defs/jobSubmitRequest" },
    { "$ref": "#/$defs/jobAdmissionReceipt" },
    { "$ref": "#/$defs/jobStatusRequest" },
    { "$ref": "#/$defs/jobStatus" },
    { "$ref": "#/$defs/jobResultRequest" },
    { "$ref": "#/$defs/jobResult" },
    { "$ref": "#/$defs/jobCancelRequest" },
    { "$ref": "#/$defs/jobCancelReceipt" },
    { "$ref": "#/$defs/serviceJobError" }
  ],
  "properties": {
    "capabilities": {
      "type": "array",
      "description": "Host-less capability tokens. Must include the exact opaque service-job contract token.",
      "items": { "type": "string" },
      "contains": { "const": "contract: service-job/v0" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "capabilities": {
      "type": "array",
      "description": "Host-less capability tokens. Must include the exact opaque service-job contract token.",
      "items": { "type": "string" },
      "contains": { "const": "contract: service-job/v0" },
      "minItems": 1,
      "uniqueItems": true
    },
    "idToken": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier. Never a credential."
    },
    "actorRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "description": "Actor identity reference. Never a credential, raw token, or machine-local path."
    },
    "refToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "description": "Symbolic reference. Never a credential, raw token, or machine-local path."
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "jobState": {
      "enum": [
        "accepted",
        "queued",
        "running",
        "cancel_requested",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "observeHint": {
      "type": "object",
      "additionalProperties": false,
      "description": "Wait binding without a start position. The consumer's agent-wait registration supplies baseline_policy XOR start_anchor.",
      "required": ["method_id", "subject_kind", "subject_id"],
      "properties": {
        "method_id": { "const": "job_complete" },
        "subject_kind": { "const": "service_job" },
        "subject_id": { "$ref": "#/$defs/idToken" }
      }
    },
    "jobSpecDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "algorithm", "value"],
      "properties": {
        "canonicalization": { "const": "rfc8785" },
        "algorithm": { "const": "sha256" },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_ref", "placement"],
      "properties": {
        "backend_ref": { "$ref": "#/$defs/refToken" },
        "placement": { "enum": ["local", "hosted"] }
      }
    },
    "catalogService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "title"],
      "properties": {
        "service_id": { "$ref": "#/$defs/idToken" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "jobOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "role"],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/refToken" },
        "role": { "$ref": "#/$defs/idToken" },
        "media_type": { "type": "string", "minLength": 1 }
      }
    },
    "catalogListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "page"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "catalog_list_request" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "catalog_revision": { "$ref": "#/$defs/idToken" },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit"],
          "properties": {
            "limit": { "type": "integer", "minimum": 1 },
            "cursor": { "$ref": "#/$defs/idToken" }
          }
        }
      }
    },
    "catalogListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "request_ref",
        "catalog_revision",
        "authorization_filtered",
        "services",
        "page"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "catalog_list_response" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "request_ref": { "$ref": "#/$defs/idToken" },
        "catalog_revision": { "$ref": "#/$defs/idToken" },
        "authorization_filtered": { "type": "boolean" },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogService" }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit"],
          "properties": {
            "limit": { "type": "integer", "minimum": 1 },
            "next_cursor": { "$ref": "#/$defs/idToken" }
          }
        }
      }
    },
    "serviceDescribeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "service_id",
        "catalog_revision"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "service_describe_request" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "service_id": { "$ref": "#/$defs/idToken" },
        "catalog_revision": { "$ref": "#/$defs/idToken" }
      }
    },
    "serviceOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "request_ref",
        "service_id",
        "catalog_revision",
        "offer_revision",
        "backends"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "service_offer" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "request_ref": { "$ref": "#/$defs/idToken" },
        "service_id": { "$ref": "#/$defs/idToken" },
        "catalog_revision": { "$ref": "#/$defs/idToken" },
        "offer_revision": { "$ref": "#/$defs/idToken" },
        "title": { "type": "string", "minLength": 1 },
        "backends": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/backend" }
        }
      }
    },
    "jobSubmitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "service_id",
        "catalog_revision",
        "offer_revision",
        "job_spec",
        "job_spec_digest"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "job_submit_request" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "service_id": { "$ref": "#/$defs/idToken" },
        "catalog_revision": { "$ref": "#/$defs/idToken" },
        "offer_revision": { "$ref": "#/$defs/idToken" },
        "idempotency_key": { "$ref": "#/$defs/idToken" },
        "job_spec": {
          "type": "object",
          "minProperties": 1
        },
        "job_spec_digest": { "$ref": "#/$defs/jobSpecDigest" },
        "placement": { "enum": ["local", "hosted"] },
        "backend_ref": { "$ref": "#/$defs/refToken" },
        "egress_authorization_ref": { "$ref": "#/$defs/refToken" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "placement": { "const": "hosted" } },
            "required": ["placement"]
          },
          "then": {
            "required": ["backend_ref", "egress_authorization_ref"]
          }
        }
      ]
    },
    "jobAdmissionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "submit_ref",
        "admission",
        "job_spec_digest"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "job_admission_receipt" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "submit_ref": { "$ref": "#/$defs/idToken" },
        "admission": { "enum": ["accepted", "unknown", "conflict", "rejected"] },
        "job_id": { "$ref": "#/$defs/idToken" },
        "resolved_backend_ref": { "$ref": "#/$defs/refToken" },
        "resolved_placement": { "enum": ["local", "hosted"] },
        "observe_hint": { "$ref": "#/$defs/observeHint" },
        "job_spec_digest": { "$ref": "#/$defs/jobSpecDigest" },
        "reason_code": { "$ref": "#/$defs/idToken" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "admission": { "const": "accepted" } },
            "required": ["admission"]
          },
          "then": {
            "required": ["job_id", "resolved_backend_ref", "resolved_placement", "observe_hint"]
          }
        }
      ]
    },
    "jobStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "job_id"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "job_status_request" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "job_id": { "$ref": "#/$defs/idToken" }
      }
    },
    "jobStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "job_id",
        "state",
        "observe_hint"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "job_status" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "job_id": { "$ref": "#/$defs/idToken" },
        "state": { "$ref": "#/$defs/jobState" },
        "observe_hint": { "$ref": "#/$defs/observeHint" }
      }
    },
    "jobResultRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "job_id"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "job_result_request" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "job_id": { "$ref": "#/$defs/idToken" }
      }
    },
    "jobResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "job_id",
        "state"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "job_result" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "job_id": { "$ref": "#/$defs/idToken" },
        "state": { "$ref": "#/$defs/jobState" },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/jobOutput" }
        },
        "reason_code": { "$ref": "#/$defs/idToken" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "succeeded" } },
            "required": ["state"]
          },
          "then": {
            "required": ["outputs"],
            "properties": {
              "outputs": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": { "enum": ["accepted", "queued", "running", "cancel_requested"] }
            },
            "required": ["state"]
          },
          "then": {
            "required": ["reason_code"],
            "properties": {
              "reason_code": { "const": "result_not_ready" }
            }
          }
        }
      ]
    },
    "jobCancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "job_id"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "job_cancel_request" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "job_id": { "$ref": "#/$defs/idToken" }
      }
    },
    "jobCancelReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "job_id",
        "cancel_admission",
        "job_state"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "job_cancel_receipt" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "job_id": { "$ref": "#/$defs/idToken" },
        "cancel_admission": { "enum": ["accepted", "rejected", "unknown"] },
        "job_state": { "$ref": "#/$defs/jobState" }
      }
    },
    "serviceJobError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "message_type",
        "message_id",
        "correlation_id",
        "created_at",
        "actor_ref",
        "error_code",
        "retryable"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "message_type": { "const": "service_job_error" },
        "message_id": { "$ref": "#/$defs/idToken" },
        "correlation_id": { "$ref": "#/$defs/idToken" },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "actor_ref": { "$ref": "#/$defs/actorRef" },
        "causation_id": { "$ref": "#/$defs/idToken" },
        "grant_ref": { "$ref": "#/$defs/refToken" },
        "verification_receipt_ref": { "$ref": "#/$defs/refToken" },
        "policy_decision_ref": { "$ref": "#/$defs/refToken" },
        "error_code": { "$ref": "#/$defs/idToken" },
        "retryable": { "type": "boolean" },
        "related_ref": { "$ref": "#/$defs/idToken" }
      }
    }
  }
}
