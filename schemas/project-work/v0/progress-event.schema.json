{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:project-work/v0/progress-event.schema.json",
  "title": "Progress Event",
  "description": "Structural schema companion for contract: project-work/v0. One NDJSON line of the append-only work ledger. Envelope is contract-governed; extra keys on data are producer-owned except reserved core transition keys, which are reserved by kind. Kinds are locked; each kind has authoritative transition semantics so a consumer can project lifecycle state. seq is the per-subject order key (timestamp is not).",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "kind", "actor", "seq", "data"],
  "oneOf": [{ "required": ["packet_id"] }, { "required": ["project_id"] }],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "packet_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": {
      "enum": ["created", "class-changed", "reopened", "blocked", "unblocked"]
    },
    "actor": { "$ref": "#/$defs/actor" },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per-subject sequence. The ledger order key. Gaps indicate loss; regression indicates corruption."
    },
    "data": {
      "type": "object",
      "description": "Transition payload. Core from/to and lifecycle_class keys are contract-governed and reserved by kind; additional properties are producer-owned."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "created" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["lifecycle_class"],
            "properties": {
              "lifecycle_class": { "$ref": "#/$defs/lifecycle-class" },
              "from": false,
              "to": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "class-changed" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "$ref": "#/$defs/lifecycle-class" },
              "to": { "$ref": "#/$defs/lifecycle-class" },
              "lifecycle_class": false
            },
            "allOf": [
              {
                "not": {
                  "properties": { "to": { "const": "blocked" } },
                  "required": ["to"]
                }
              },
              {
                "not": {
                  "properties": { "from": { "const": "blocked" } },
                  "required": ["from"]
                }
              },
              {
                "not": {
                  "properties": {
                    "from": { "enum": ["done", "cancelled"] }
                  },
                  "required": ["from"]
                }
              },
              {
                "if": {
                  "properties": { "from": { "const": "draft" } },
                  "required": ["from"]
                },
                "then": {
                  "properties": { "to": { "not": { "const": "draft" } } }
                }
              },
              {
                "if": {
                  "properties": { "from": { "const": "ready" } },
                  "required": ["from"]
                },
                "then": {
                  "properties": { "to": { "not": { "const": "ready" } } }
                }
              },
              {
                "if": {
                  "properties": { "from": { "const": "active" } },
                  "required": ["from"]
                },
                "then": {
                  "properties": { "to": { "not": { "const": "active" } } }
                }
              },
              {
                "if": {
                  "properties": { "from": { "const": "review" } },
                  "required": ["from"]
                },
                "then": {
                  "properties": { "to": { "not": { "const": "review" } } }
                }
              },
              {
                "if": {
                  "properties": { "from": { "const": "done" } },
                  "required": ["from"]
                },
                "then": {
                  "properties": { "to": { "not": { "const": "done" } } }
                }
              },
              {
                "if": {
                  "properties": { "from": { "const": "cancelled" } },
                  "required": ["from"]
                },
                "then": {
                  "properties": { "to": { "not": { "const": "cancelled" } } }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "reopened" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "enum": ["done", "cancelled"] },
              "to": { "enum": ["draft", "ready"] },
              "lifecycle_class": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "blocked" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": {
                "enum": ["draft", "ready", "active", "review"]
              },
              "to": { "const": "blocked" },
              "lifecycle_class": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "unblocked" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "const": "blocked" },
              "to": {
                "enum": ["draft", "ready", "active", "review"]
              },
              "lifecycle_class": false
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "lifecycle-class": {
      "enum": ["draft", "ready", "active", "blocked", "review", "done", "cancelled"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "description": "Who acted. person, role, agent, or run; agent and run follow the ready-packet party shapes. A run actor names its parent and expires, so a ledger line from a run stays attributable after the run ends.",
      "properties": {
        "kind": { "enum": ["person", "role", "agent", "run"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "$ref": "#/$defs/role-slug" },
        "parent": { "$ref": "#/$defs/run-parent" },
        "expires": { "$ref": "#/$defs/instant" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "person" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/person-id" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "role" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/role-slug" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["person", "role"] } },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["role"] },
                { "required": ["parent"] },
                { "required": ["expires"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["role"],
            "properties": { "id": { "$ref": "#/$defs/agent-id" } },
            "not": {
              "anyOf": [{ "required": ["parent"] }, { "required": ["expires"] }]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "run" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["parent", "expires"],
            "properties": { "id": { "$ref": "#/$defs/run-id" } }
          }
        }
      ]
    },
    "agent-id": {
      "type": "string",
      "pattern": "^agent-[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Seat id of a hosted agent. The seat registry, not this schema, says what the seat is; resolution is a consumer check."
    },
    "run-id": {
      "type": "string",
      "pattern": "^run-[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Id of one bounded run: run- plus a 26-character ULID in canonical uppercase Crockford base32. The first ULID character is 0-7 (the 48-bit timestamp ceiling); lowercase is not accepted."
    },
    "run-parent": {
      "anyOf": [{ "$ref": "#/$defs/agent-id" }, { "$ref": "#/$defs/person-id" }],
      "description": "The party a run acts for: an agent seat id or a person id. Never another run, so runs cannot chain: the run- prefix is not a valid agent or person id."
    },
    "person-id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": { "pattern": "^(agent|run)-" },
      "description": "Person id: lowercase letter first, then lowercase letters, digits, dot, underscore, or hyphen, 1-64 characters. The agent- and run- prefixes are reserved for agent seats and runs, so a person id can never be mistaken for either."
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Strict RFC 3339 instant: a T time part with Z or a numeric UTC offset. A date alone is ambiguous across time zones and is rejected."
    },
    "role-slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "minLength": 2,
      "maxLength": 16,
      "description": "Exact role-prompt slug shape (no hyphens)."
    }
  }
}
