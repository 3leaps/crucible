{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:project-work/v0/control-record.schema.json",
  "title": "Control Record",
  "description": "Structural schema companion for contract: project-work/v0. One status note, blocker, or decision. Kind closes kind-owned fields: decisions own decider and affects (non-empty, unique); status and blocker forbid them. Class changes are progress events, not status notes. Subject is typed: exactly one of packet_id or project_id. Journal-set rules (blocked requires an open blocker) are consumer-enforced, not proven by structural make check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "summary", "ts", "actor"],
  "oneOf": [{ "required": ["packet_id"] }, { "required": ["project_id"] }],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": { "enum": ["status", "blocker", "decision"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "ts": { "type": "string", "format": "date-time" },
    "actor": { "$ref": "#/$defs/actor" },
    "open": {
      "type": "boolean",
      "description": "For blocker records: whether the blocker still applies. Default true when omitted."
    },
    "waiting_on": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Opaque description of the missing fact, person, or decision. Not a chat wait-state."
    },
    "decider": { "$ref": "#/$defs/decider" },
    "affects": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "minItems": 1,
      "uniqueItems": true,
      "description": "For decision records: the packet or project ids this decision governs. Decision-owned; forbidden on status and blocker records."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "status" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "waiting_on": false,
          "decider": false,
          "open": false,
          "affects": false
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "blocker" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["waiting_on"],
        "properties": {
          "decider": false,
          "affects": false
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "decision" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["decider", "affects"],
        "properties": {
          "waiting_on": false,
          "open": false
        }
      }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "description": "Who acted. person, role, agent, or run; agent and run follow the ready-packet party shapes. A run actor names its parent and expires, so a ledger line from a run stays attributable after the run ends.",
      "properties": {
        "kind": { "enum": ["person", "role", "agent", "run"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "$ref": "#/$defs/role-slug" },
        "parent": { "$ref": "#/$defs/run-parent" },
        "expires": { "$ref": "#/$defs/instant" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "person" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/person-id" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "role" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/role-slug" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["person", "role"] } },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["role"] },
                { "required": ["parent"] },
                { "required": ["expires"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["role"],
            "properties": { "id": { "$ref": "#/$defs/agent-id" } },
            "not": {
              "anyOf": [{ "required": ["parent"] }, { "required": ["expires"] }]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "run" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["parent", "expires"],
            "properties": { "id": { "$ref": "#/$defs/run-id" } }
          }
        }
      ]
    },
    "agent-id": {
      "type": "string",
      "pattern": "^agent-[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Seat id of a hosted agent. The seat registry, not this schema, says what the seat is; resolution is a consumer check."
    },
    "run-id": {
      "type": "string",
      "pattern": "^run-[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Id of one bounded run: run- plus a 26-character ULID in canonical uppercase Crockford base32. The first ULID character is 0-7 (the 48-bit timestamp ceiling); lowercase is not accepted."
    },
    "run-parent": {
      "anyOf": [{ "$ref": "#/$defs/agent-id" }, { "$ref": "#/$defs/person-id" }],
      "description": "The party a run acts for: an agent seat id or a person id. Never another run, so runs cannot chain: the run- prefix is not a valid agent or person id."
    },
    "person-id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": { "pattern": "^(agent|run)-" },
      "description": "Person id: lowercase letter first, then lowercase letters, digits, dot, underscore, or hyphen, 1-64 characters. The agent- and run- prefixes are reserved for agent seats and runs, so a person id can never be mistaken for either."
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Strict RFC 3339 instant: a T time part with Z or a numeric UTC offset. A date alone is ambiguous across time zones and is rejected."
    },
    "decider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "description": "Who decides. person, role, or agent; never unassigned and never a run, because a decision outlives the run that records it.",
      "properties": {
        "kind": { "enum": ["person", "role", "agent"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "$ref": "#/$defs/role-slug" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "person" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/person-id" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "role" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/role-slug" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["person", "role"] } },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [{ "required": ["role"] }]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["role"],
            "properties": { "id": { "$ref": "#/$defs/agent-id" } }
          }
        }
      ]
    },
    "role-slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "minLength": 2,
      "maxLength": 16,
      "description": "Exact role-prompt slug shape (no hyphens)."
    }
  }
}
