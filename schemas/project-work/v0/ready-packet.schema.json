{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:project-work/v0/ready-packet.schema.json",
  "title": "Ready Packet",
  "description": "Structural schema companion for contract: project-work/v0. The ready packet is the dispatchable unit of work: outcome, owner, lifecycle class, and acceptance. Hierarchy is forbidden. Journal-set rules are consumer-enforced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilities",
    "id",
    "outcome",
    "owner",
    "lifecycle_class",
    "acceptance",
    "updated"
  ],
  "properties": {
    "capabilities": {
      "type": "array",
      "description": "Host-less capability tokens. Must include the exact opaque project-work contract token.",
      "items": { "type": "string" },
      "contains": { "const": "contract: project-work/v0" },
      "minItems": 1,
      "uniqueItems": true
    },
    "id": { "$ref": "#/$defs/opaque-id" },
    "scope": { "$ref": "#/$defs/scope-path" },
    "slug": { "$ref": "#/$defs/display-slug" },
    "project_id": { "$ref": "#/$defs/opaque-id" },
    "milestone_id": { "$ref": "#/$defs/opaque-id" },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "The desired result in one breath. Completion is recognized against this plus acceptance."
    },
    "boundary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "What is out of scope."
    },
    "owner": { "$ref": "#/$defs/owner" },
    "requested_by": { "$ref": "#/$defs/requester" },
    "lifecycle_class": { "$ref": "#/$defs/lifecycle-class" },
    "acceptance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "description": "Checkable completion criteria. Required (min 1) on dispatchable classes ready, active, review, and done. Empty is allowed on draft, blocked, and cancelled."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "note": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/opaque-id" },
          "kind": { "enum": ["packet", "project", "decision", "external"] }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {
          "$ref": "#/$defs/role-slug",
          "description": "Accountable escalation target as a role slug. Not a closed catalog of one org's seats."
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "check_by": {
      "$ref": "#/$defs/instant",
      "description": "Strict RFC 3339 instant (T time part with Z or a UTC offset; date-only is rejected) by which the accountable owner is next expected to report status or acknowledge this packet. A check-in time, not a completion deadline. Optional; enforcement (scheduling a wake) belongs to the consumer."
    },
    "priority": { "enum": ["p0", "p1", "p2", "p3"] },
    "labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/display-slug" },
      "uniqueItems": true
    },
    "classifiers": { "$ref": "#/$defs/classifiers" },
    "updated": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "owner": {
            "properties": { "kind": { "const": "run" } },
            "required": ["kind"]
          },
          "lifecycle_class": { "not": { "enum": ["done", "cancelled"] } }
        },
        "required": ["owner", "lifecycle_class"]
      },
      "then": { "required": ["check_by"] }
    },
    {
      "if": {
        "properties": {
          "lifecycle_class": {
            "enum": ["ready", "active", "review", "done"]
          }
        },
        "required": ["lifecycle_class"]
      },
      "then": {
        "properties": {
          "owner": {
            "not": {
              "properties": { "kind": { "const": "unassigned" } },
              "required": ["kind"]
            }
          },
          "acceptance": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "opaque-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Opaque identity. Instance prefixes are local convention, not a closed enum."
    },
    "scope-path": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(/[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
      "maxLength": 253
    },
    "display-slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 63
    },
    "role-slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "minLength": 2,
      "maxLength": 16,
      "description": "Exact role-prompt slug shape (lowercase letters/numbers, no hyphens, 2–16)."
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Strict RFC 3339 instant: a T time part with Z or a numeric UTC offset. A date alone is ambiguous across time zones and is rejected."
    },
    "agent-id": {
      "type": "string",
      "pattern": "^agent-[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Seat id of a hosted agent. The seat registry, not this schema, says what the seat is; resolution is a consumer check."
    },
    "run-id": {
      "type": "string",
      "pattern": "^run-[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Id of one bounded run: run- plus a 26-character ULID in canonical uppercase Crockford base32. The first ULID character is 0-7 (the 48-bit timestamp ceiling); lowercase is not accepted."
    },
    "run-parent": {
      "anyOf": [{ "$ref": "#/$defs/agent-id" }, { "$ref": "#/$defs/person-id" }],
      "description": "The party a run acts for: an agent seat id or a person id. Never another run, so runs cannot chain: the run- prefix is not a valid agent or person id."
    },
    "person-id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": { "pattern": "^(agent|run)-" },
      "description": "Person id: lowercase letter first, then lowercase letters, digits, dot, underscore, or hyphen, 1-64 characters. The agent- and run- prefixes are reserved for agent seats and runs, so a person id can never be mistaken for either."
    },
    "lifecycle-class": {
      "enum": ["draft", "ready", "active", "blocked", "review", "done", "cancelled"],
      "description": "Semantic class, not a board column."
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "description": "Who asked for or is owed this work. Same shape as an owner without unassigned and without run: a request always has a durable named party (person, role, or agent), never a bounded run.",
      "properties": {
        "kind": { "enum": ["person", "role", "agent"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "$ref": "#/$defs/role-slug" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["person", "role"] } },
            "required": ["kind"]
          },
          "then": { "not": { "required": ["role"] } }
        },
        {
          "if": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["role"],
            "properties": { "id": { "$ref": "#/$defs/agent-id" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "person" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/person-id" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "role" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/role-slug" } }
          }
        }
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["person", "role", "unassigned", "agent", "run"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "$ref": "#/$defs/role-slug" },
        "parent": { "$ref": "#/$defs/run-parent" },
        "expires": { "$ref": "#/$defs/instant" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["person", "role", "unassigned"] } },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["role"] },
                { "required": ["parent"] },
                { "required": ["expires"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["id", "role"],
            "properties": { "id": { "$ref": "#/$defs/agent-id" } },
            "not": {
              "anyOf": [{ "required": ["parent"] }, { "required": ["expires"] }]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "run" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["id", "parent", "expires"],
            "properties": { "id": { "$ref": "#/$defs/run-id" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["person", "role"] } },
            "required": ["kind"]
          },
          "then": { "required": ["id"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "person" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/person-id" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "role" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "id": { "$ref": "#/$defs/role-slug" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "unassigned" } },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [{ "required": ["id"] }, { "required": ["display"] }]
            }
          }
        }
      ]
    },
    "classifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitivity", "access-tier"],
      "description": "Reuse of catalog dimensions. Cross-enum floor access-tier >= sensitivity per docs/standards/access-tier-classification.md. unknown is valid only as a pair.",
      "properties": {
        "sensitivity": {
          "enum": [
            "unknown",
            "0-public",
            "1-confidential",
            "2-blinded",
            "3-proprietary",
            "4-personal",
            "5-privileged",
            "6-eyes-only"
          ]
        },
        "access-tier": {
          "enum": ["unknown", "public", "internal", "restricted", "privileged", "eyes-only"]
        },
        "retention-lifecycle": {
          "enum": ["unknown", "transient", "short", "standard", "long", "legal-hold"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sensitivity": { "const": "unknown" } }
          },
          "then": {
            "properties": { "access-tier": { "const": "unknown" } }
          }
        },
        {
          "if": {
            "properties": { "access-tier": { "const": "unknown" } }
          },
          "then": {
            "properties": { "sensitivity": { "const": "unknown" } }
          }
        },
        {
          "if": {
            "properties": { "sensitivity": { "const": "0-public" } }
          },
          "then": {
            "properties": {
              "access-tier": {
                "enum": ["public", "internal", "restricted", "privileged", "eyes-only"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "sensitivity": { "const": "1-confidential" } }
          },
          "then": {
            "properties": {
              "access-tier": {
                "enum": ["internal", "restricted", "privileged", "eyes-only"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "sensitivity": { "const": "2-blinded" } }
          },
          "then": {
            "properties": {
              "access-tier": {
                "enum": ["internal", "restricted", "privileged", "eyes-only"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "sensitivity": { "const": "3-proprietary" } }
          },
          "then": {
            "properties": {
              "access-tier": {
                "enum": ["restricted", "privileged", "eyes-only"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "sensitivity": { "const": "4-personal" } }
          },
          "then": {
            "properties": {
              "access-tier": { "enum": ["privileged", "eyes-only"] }
            }
          }
        },
        {
          "if": {
            "properties": { "sensitivity": { "const": "5-privileged" } }
          },
          "then": {
            "properties": {
              "access-tier": { "enum": ["privileged", "eyes-only"] }
            }
          }
        },
        {
          "if": {
            "properties": { "sensitivity": { "const": "6-eyes-only" } }
          },
          "then": {
            "properties": { "access-tier": { "const": "eyes-only" } }
          }
        }
      ]
    }
  }
}
