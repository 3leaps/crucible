{
  "v": 0,
  "id": "reject-op-result-fabricated",
  "mode": "retrying",
  "covers": [
    "transition.permitted",
    "retry.limits",
    "retry.persisted-jitter"
  ],
  "definitions": {
    "d1": {
      "retry.backoff": {
        "initial": "PT1M",
        "max": "PT30M",
        "multiplier_milli": 2000,
        "jitter_milli": 0
      }
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "advance_clock",
      "by": "PT5M",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "waiting",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "result": "failed",
        "effects": "none",
        "dispatch": "confirmed",
        "reason": "source_unavailable",
        "outcome": "source_unavailable"
      },
      "expect": {
        "ok": {
          "state": "waiting"
        }
      },
      "next_eligible_at": "2026-01-02T00:06:00.000000Z",
      "reason": "retry_scheduled"
    },
    {
      "op": "advance_clock",
      "by": "PT1M",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 2,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "succeeded",
      "attempt": {
        "n": 2,
        "phase": "finish",
        "result": "succeeded",
        "outcome": "captured_verified",
        "effects": "resolved",
        "dispatch": "confirmed",
        "outputs_verified": true
      },
      "expect": {
        "ok": {
          "state": "failed"
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "succeeded",
        "attempts": [
          {
            "n": 1,
            "result": "failed",
            "effects": "none",
            "dispatch": "confirmed"
          },
          {
            "n": 2,
            "result": "succeeded",
            "effects": "resolved",
            "dispatch": "confirmed"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      },
      {
        "task": "t1",
        "to": "waiting",
        "attempt": {
          "n": 1,
          "phase": "finish",
          "result": "failed"
        }
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 2,
          "phase": "start"
        }
      },
      {
        "task": "t1",
        "to": "succeeded",
        "attempt": {
          "n": 2,
          "phase": "finish",
          "result": "succeeded"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "max_attempts 3, source_unavailable retryable, jitter_milli 0 so next_eligible_at is exactly finish + PT1M; start at the eligible instant"
    },
    {
      "propose": "attempt.outputs_verified (bool) on a finish transition",
      "why": "the record requires success only with verified required outputs but the format has no field to state whether outputs verified"
    }
  ],
  "baseline": "retrying/retry-wait-then-second-attempt-succeeds.json",
  "expect_reject": "does not match"
}
