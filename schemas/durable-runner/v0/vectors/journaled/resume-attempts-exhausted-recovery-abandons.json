{
  "v": 0,
  "id": "resume-attempts-exhausted-recovery-abandons",
  "mode": "journaled",
  "covers": [
    "resume.authorization",
    "retry.limits"
  ],
  "definitions": {
    "d1": {
      "retry.retry_after_abandonment": true,
      "retry.max_attempts": 2
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "crash",
      "at": "after_effect_before_finish",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "recover",
      "generation": 2,
      "predecessor": "quiescent_proved",
      "effects": "resolved",
      "expect": {
        "ok": {
          "task_states": {
            "t1": "waiting"
          },
          "executed_effects": 0
        }
      },
      "next_eligible_at": "2026-01-02T00:01:00.000000Z"
    },
    {
      "op": "advance_clock",
      "by": "PT1M",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 2,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "crash",
      "at": "after_effect_before_finish",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "recover",
      "generation": 3,
      "predecessor": "quiescent_proved",
      "effects": "resolved",
      "expect": {
        "ok": {
          "task_states": {
            "t1": "abandoned"
          },
          "executed_effects": 0
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "abandoned",
        "attempts": [
          {
            "n": 1,
            "result": "abandoned",
            "effects": "resolved"
          },
          {
            "n": 2,
            "result": "abandoned",
            "effects": "resolved"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      },
      {
        "task": "t1",
        "to": "waiting",
        "attempt": {
          "n": 1,
          "phase": "finish",
          "result": "abandoned"
        }
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 2,
          "phase": "start"
        }
      },
      {
        "task": "t1",
        "to": "abandoned",
        "attempt": {
          "n": 2,
          "phase": "finish",
          "result": "abandoned"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "both permitted attempts were used, retry after abandonment is granted, effects are resolved and the horizon is unset; recovery therefore abandons the task, because an exhausted task never returns to waiting"
    }
  ]
}
