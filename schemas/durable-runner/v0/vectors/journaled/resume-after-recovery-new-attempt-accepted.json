{
  "v": 0,
  "id": "resume-after-recovery-new-attempt-accepted",
  "mode": "journaled",
  "covers": [
    "resume.authorization"
  ],
  "definitions": {
    "d1": {
      "retry.retry_after_abandonment": true
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "crash",
      "at": "after_effect_before_finish",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "recover",
      "generation": 2,
      "predecessor": "quiescent_proved",
      "effects": "resolved",
      "expect": {
        "ok": {
          "task_states": {
            "t1": "waiting"
          },
          "executed_effects": 0
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 2,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "abandoned",
            "effects": "resolved"
          },
          {
            "n": 2,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      },
      {
        "task": "t1",
        "to": "waiting",
        "attempt": {
          "n": 1,
          "phase": "finish",
          "result": "abandoned"
        }
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 2,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "predecessor quiescence proved, effects resolved, retry after abandonment permitted, horizon and deadline open, attempt 2 contiguous within the limit; the retried execution gets a new attempt identity and the abandoned attempt is not rewritten"
    }
  ]
}
