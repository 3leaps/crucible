{
  "v": 0,
  "id": "crash-uncommitted-cursor-not-checkpointable",
  "mode": "journaled",
  "covers": [
    "crash.before-record-commit",
    "checkpoint.ordering"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "crash",
      "at": "before_record_commit",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "checkpoint",
      "task": "t1",
      "cursor_revision": 3,
      "body": {
        "verified": true,
        "staged": "before_record"
      },
      "expect": {
        "refused": "cursor_not_in_chain"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "body verified and staged before the record; only the cursor revision 3 does not exist (chain has revisions 1 and 2)"
    }
  ]
}
