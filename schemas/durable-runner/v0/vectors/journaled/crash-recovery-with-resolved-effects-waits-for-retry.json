{
  "v": 0,
  "id": "crash-recovery-with-resolved-effects-waits-for-retry",
  "mode": "journaled",
  "covers": [
    "crash.after-effect-before-finish"
  ],
  "definitions": {
    "d1": {
      "retry.backoff": {
        "initial": "PT1M",
        "max": "PT30M",
        "multiplier_milli": 2000,
        "jitter_milli": 0
      },
      "retry.retry_after_abandonment": true
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "crash",
      "at": "after_effect_before_finish",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "recover",
      "generation": 2,
      "predecessor": "quiescent_proved",
      "effects": "resolved",
      "expect": {
        "ok": {
          "task_states": {
            "t1": "waiting"
          },
          "executed_effects": 0
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "waiting",
        "attempts": [
          {
            "n": 1,
            "result": "abandoned",
            "effects": "resolved"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      },
      {
        "task": "t1",
        "to": "waiting",
        "attempt": {
          "n": 1,
          "phase": "finish",
          "result": "abandoned"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "only effects differ from the unknown-effects twin; attempts remain"
    }
  ]
}
