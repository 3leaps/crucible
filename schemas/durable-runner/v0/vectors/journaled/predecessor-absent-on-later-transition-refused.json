{
  "v": 0,
  "id": "predecessor-absent-on-later-transition-refused",
  "mode": "journaled",
  "covers": [
    "predecessor.chain-conflict"
  ],
  "definitions": {
    "d1": {
      "retry.backoff": {
        "initial": "PT1M",
        "max": "PT30M",
        "multiplier_milli": 2000,
        "jitter_milli": 0
      }
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "prior": "absent",
      "expect": {
        "refused": "predecessor_mismatch"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "pending",
        "attempts": []
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      }
    ]
  },
  "notes": [
    {
      "competing": "only the missing predecessor pin; the first record already exists so a transition with no predecessor is a mismatch, not first_not_pending"
    }
  ]
