{
  "v": 0,
  "id": "transition-waiting-to-cancelled",
  "mode": "basic",
  "covers": [
    "transition.permitted",
    "cancel.quiescence"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "waiting",
      "reason": "blocked",
      "expect": {
        "ok": {
          "state": "waiting"
        }
      }
    },
    {
      "op": "request_cancel",
      "task": "t1",
      "expect": {
        "ok": {
          "effect": "recorded"
        }
      }
    },
    {
      "op": "confirm_cancel",
      "task": "t1",
      "quiescent": true,
      "expect": {
        "ok": {
          "state": "cancelled"
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "cancelled",
        "attempts": []
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "waiting"
      },
      {
        "task": "t1",
        "to": "cancelled"
      }
    ]
  },
  "notes": [
    {
      "competing": "no attempt exists"
    }
  ]
}
