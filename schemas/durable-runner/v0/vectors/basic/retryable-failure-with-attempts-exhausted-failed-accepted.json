{
  "v": 0,
  "id": "retryable-failure-with-attempts-exhausted-failed-accepted",
  "mode": "basic",
  "covers": [
    "retry.limits"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "failed",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "dispatch": "confirmed",
        "effects": "none",
        "result": "failed",
        "outcome": "source_unavailable"
      },
      "expect": {
        "ok": {
          "state": "failed"
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "failed",
        "attempts": [
          {
            "n": 1,
            "result": "failed",
            "effects": "none",
            "dispatch": "confirmed"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      },
      {
        "task": "t1",
        "to": "failed",
        "attempt": {
          "n": 1,
          "phase": "finish",
          "result": "failed"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "twin of the retry-required refusal with max_attempts 1, so retry is exhausted"
    }
  ]
}
