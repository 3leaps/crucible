{
  "v": 0,
  "id": "cancel-direct-transition-unconfirmed-refused",
  "mode": "basic",
  "covers": [
    "cancel.quiescence"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "cancelled",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "result": "cancelled",
        "effects": "none"
      },
      "expect": {
        "refused": "cancellation_not_confirmed"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "the finish names the live attempt, a cancelled result and none effects, so every attempt-level rule is satisfied; only the cancellation was never requested and confirmed"
    }
  ]
}
