{
  "v": 0,
  "id": "transition-finish-attempt-number-mismatch-refused",
  "mode": "basic",
  "covers": [
    "transition.illegal"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "succeeded",
      "attempt": {
        "n": 2,
        "phase": "finish",
        "dispatch": "confirmed",
        "result": "succeeded",
        "outcome": "captured_verified",
        "effects": "resolved",
        "outputs_verified": true
      },
      "expect": {
        "refused": "attempt_mismatch"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "the finish is otherwise valid; only it names attempt 2 while attempt 1 is the live attempt"
    }
  ]
}
