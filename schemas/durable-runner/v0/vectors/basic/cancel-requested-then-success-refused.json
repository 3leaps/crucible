{
  "v": 0,
  "id": "cancel-requested-then-success-refused",
  "mode": "basic",
  "covers": [
    "cancel.race"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "request_cancel",
      "task": "t1",
      "expect": {
        "ok": {
          "effect": "recorded"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "succeeded",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "result": "succeeded",
        "outcome": "captured_verified",
        "effects": "resolved",
        "dispatch": "confirmed",
        "outputs_verified": true
      },
      "expect": {
        "refused": "cancellation_precedes_success"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "outputs verified, effects resolved, outcome code mapped to success, predecessor is the head and attempt 1 is contiguous within max_attempts; the only applicable rule is that the durable cancellation request committed first. Twin: transition-running-to-succeeded without a request"
    }
  ]
}
