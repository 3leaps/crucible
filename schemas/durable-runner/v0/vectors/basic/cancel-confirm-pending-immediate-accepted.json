{
  "v": 0,
  "id": "cancel-confirm-pending-immediate-accepted",
  "mode": "basic",
  "covers": [
    "cancel.quiescence"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "request_cancel",
      "task": "t1",
      "expect": {
        "ok": {
          "effect": "recorded"
        }
      }
    },
    {
      "op": "confirm_cancel",
      "task": "t1",
      "quiescent": false,
      "expect": {
        "ok": {
          "state": "cancelled"
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "cancelled",
        "attempts": []
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "pending",
        "cancellation": "requested"
      },
      {
        "task": "t1",
        "to": "cancelled"
      }
    ]
  },
  "notes": [
    {
      "competing": "a pending task has no live work, so confirmation needs no quiescence assertion; twin of cancel-quiescence-not-established-refused (a running attempt)"
    }
  ]
}
