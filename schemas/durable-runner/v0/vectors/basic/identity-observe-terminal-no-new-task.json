{
  "v": 0,
  "id": "identity-observe-terminal-no-new-task",
  "mode": "basic",
  "covers": [
    "identity.reuse-observed"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    },
    "d2": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "succeeded",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "result": "succeeded",
        "outcome": "captured_verified",
        "effects": "resolved",
        "dispatch": "confirmed",
        "outputs_verified": true
      },
      "expect": {
        "ok": {
          "state": "succeeded"
        }
      }
    },
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d2",
      "expect": {
        "ok": {
          "disposition": "observed",
          "state": "succeeded"
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "succeeded",
        "attempts": [
          {
            "n": 1,
            "result": "succeeded",
            "effects": "resolved",
            "dispatch": "confirmed"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      },
      {
        "task": "t1",
        "to": "succeeded",
        "attempt": {
          "n": 1,
          "phase": "finish",
          "result": "succeeded"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "terminal task observed, not restarted; terminal state is not a refusal for submit"
    }
  ]
}
