{
  "v": 0,
  "id": "cancel-quiescence-not-established-refused",
  "mode": "basic",
  "covers": [
    "cancel.quiescence"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "request_cancel",
      "task": "t1",
      "expect": {
        "ok": {
          "effect": "recorded"
        }
      }
    },
    {
      "op": "confirm_cancel",
      "task": "t1",
      "quiescent": false,
      "expect": {
        "refused": "quiescence_not_established"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "request recorded so cancel_not_requested cannot fire; twin is transition-running-to-cancelled with quiescent true"
    }
  ]
}
