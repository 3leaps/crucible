{
  "v": 0,
  "id": "transition-running-without-attempt-refused",
  "mode": "basic",
  "covers": [
    "transition.illegal"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "waiting",
      "reason": "blocked",
      "expect": {
        "refused": "attempt_required"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "running to waiting is a permitted pair; only the missing attempt finish fact refuses, so no attempt-level guard can be skipped"
    }
  ]
}
