          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "abandoned",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "result": "abandoned",
        "effects": "resolved",
        "dispatch": "intended"
      },
      "expect": {
        "refused": "abandonment_needs_unresolved_effects"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "no code or reason is supplied and the result matches the state; only the effects are resolved, so there is nothing to abandon"
    }
  ]
