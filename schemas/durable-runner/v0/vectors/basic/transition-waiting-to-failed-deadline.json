{
  "v": 0,
  "id": "transition-waiting-to-failed-deadline",
  "mode": "basic",
  "covers": [
    "transition.permitted",
    "deadline"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "waiting",
      "reason": "blocked",
      "expect": {
        "ok": {
          "state": "waiting"
        }
      }
    },
    {
      "op": "advance_clock",
      "by": "PT7H",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "failed",
      "reason": "deadline_expired",
      "expect": {
        "ok": {
          "state": "failed"
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "failed",
        "attempts": []
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "waiting"
      },
      {
        "task": "t1",
        "to": "failed"
      }
    ]
  },
  "notes": [
    {
      "competing": "deadline elapsed; no attempt"
    }
  ]
}
