{
  "v": 0,
  "id": "attempt-limit-single-attempt-refused",
  "mode": "basic",
  "covers": [
    "retry.limits"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "advance_clock",
      "by": "PT5M",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "waiting",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "result": "failed",
        "effects": "none",
        "dispatch": "confirmed",
        "reason": "source_unavailable",
        "outcome": "source_unavailable"
      },
      "next_eligible_at": "2026-01-02T00:06:00.000000Z",
      "expect": {
        "refused": "attempt_limit_exhausted"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "source_unavailable is retryable, next_eligible_at supplied, horizon and deadline far; only max_attempts 1 blocks a retry. Twin: retry-limit-not-reached-accepted with max_attempts 3"
    }
  ]
}
