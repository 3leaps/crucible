{
  "v": 0,
  "id": "transition-finish-reason-contradicts-mapping-refused",
  "mode": "basic",
  "covers": [
    "outcome.mapping"
  ],
  "definitions": {
    "d1": {
      "retry.max_attempts": 1
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "failed",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "dispatch": "confirmed",
        "result": "failed",
        "outcome": "integrity_mismatch",
        "effects": "none",
        "reason": "source_unavailable"
      },
      "expect": {
        "refused": "outcome_mapping_mismatch"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "the outcome code and class agree; only the caller-claimed retry reason differs from the pinned mapping's integrity_failure"
    }
  ]
}
