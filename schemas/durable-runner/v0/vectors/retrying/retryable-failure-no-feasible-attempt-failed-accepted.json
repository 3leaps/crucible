{
  "v": 0,
  "id": "retryable-failure-no-feasible-attempt-failed-accepted",
  "mode": "retrying",
  "covers": [
    "retry.horizon-deadline",
    "retry.limits"
  ],
  "definitions": {
    "d1": {
      "retry.backoff": {
        "initial": "PT60S",
        "max": "PT30M",
        "multiplier_milli": 2000,
        "jitter_milli": 0
      },
      "retry.horizon": "PT30S"
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "advance_clock",
      "by": "PT10S",
      "expect": {
        "ok": {}
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "failed",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "dispatch": "confirmed",
        "effects": "none",
        "result": "failed",
        "outcome": "source_unavailable"
      },
      "expect": {
        "ok": {
          "state": "failed"
        }
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "failed",
        "attempts": [
          {
            "n": 1,
            "result": "failed",
            "effects": "none",
            "dispatch": "confirmed"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      },
      {
        "task": "t1",
        "to": "failed",
        "attempt": {
          "n": 1,
          "phase": "finish",
          "result": "failed"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "the failure code is retryable and attempts remain, but the exact 60s delay cannot fit before the horizon end (20s left), so terminal failure is permitted. Twin: retryable-failure-with-attempts-remaining-refused"
    }
  ]
}
