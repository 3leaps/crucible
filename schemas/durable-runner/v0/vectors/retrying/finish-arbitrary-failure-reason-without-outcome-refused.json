{
  "v": 0,
  "id": "finish-arbitrary-failure-reason-without-outcome-refused",
  "mode": "retrying",
  "covers": [
    "outcome.mapping"
  ],
  "definitions": {
    "d1": {
      "retry.backoff": {
        "initial": "PT1M",
        "max": "PT30M",
        "multiplier_milli": 2000,
        "jitter_milli": 0
      },
      "retry.retryable_reasons": [
        "source_unavailable",
        "process_failure"
      ]
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "failed",
      "attempt": {
        "n": 1,
        "phase": "finish",
        "result": "failed",
        "effects": "none",
        "dispatch": "confirmed",
        "reason": "disk_full"
      },
      "expect": {
        "refused": "outcome_required"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "a terminal failure with effects none and no domain outcome code; the reason disk_full is a caller-chosen one outside the closed framework set, so only the missing outcome code refuses"
    }
  ]
}
