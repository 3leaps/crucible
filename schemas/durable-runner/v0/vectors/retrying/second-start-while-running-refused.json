{
  "v": 0,
  "id": "second-start-while-running-refused",
  "mode": "retrying",
  "covers": [
    "transition.illegal"
  ],
  "definitions": {
    "d1": {
      "retry.backoff": {
        "initial": "PT1M",
        "max": "PT30M",
        "multiplier_milli": 2000,
        "jitter_milli": 0
      }
    }
  },
  "ops": [
    {
      "op": "submit",
      "as": "t1",
      "authority": "a",
      "key": "k1",
      "definition": "d1",
      "expect": {
        "ok": {
          "disposition": "created",
          "state": "pending"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 1,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "ok": {
          "state": "running"
        }
      }
    },
    {
      "op": "transition",
      "task": "t1",
      "to": "running",
      "attempt": {
        "n": 2,
        "phase": "start",
        "dispatch": "intended"
      },
      "expect": {
        "refused": "illegal_transition"
      }
    }
  ],
  "expected": {
    "tasks": {
      "t1": {
        "state": "running",
        "attempts": [
          {
            "n": 1,
            "result": "running",
            "dispatch": "intended"
          }
        ]
      }
    },
    "history": [
      {
        "task": "t1",
        "to": "pending"
      },
      {
        "task": "t1",
        "to": "running",
        "attempt": {
          "n": 1,
          "phase": "start"
        }
      }
    ]
  },
  "notes": [
    {
      "competing": "n=2 contiguous and within max 3; running -> running is not in the table"
    }
  ]
}
